# Ignore git and datalad internals
.git/
.git/annex/
.gitmodules

# Ignore common hidden files
*.DS_Store
*.swp

# Ignore log/tmp files if present
/tmp/
*.log

# Ignore derivative subfolders (BIDS validator does not check derivatives)
derivatives/*/sub-*/

# Ignore dataset_description.json inside derivatives (optional, validator doesn't need to check it)
derivatives/*/dataset_description.json

